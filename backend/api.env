API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
APP_ENV=dev

DATABASE_URL=postgresql+psycopg://interviewiq:password@127.0.0.1:5432/interviewiq

S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=interviewiq-audio
S3_REGION=us-east-1

ANALYZER_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=false
ANALYZER_TIMEOUT_SEC=20
MAX_ANSWER_CHARS=6000

TRANSCRIBER_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

FCM_SERVER_KEY=
